# Deploy publico na rede de teste (devnet): app somente on-chain.
# Copie para .env.production.local (ou configure na Vercel) antes do build.
NEXT_PUBLIC_ENABLE_DEMO=false
# RPC dedicado (recomendado): https://devnet.helius-rpc.com/?api-key=<SUA_CHAVE>
# Nunca commite a chave; configure-a em .env.production.local ou nas variaveis da Vercel.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_CLUSTER_LABEL=Devnet
NEXT_PUBLIC_EXPLORER_CLUSTER=devnet
NEXT_PUBLIC_PROGRAM_ID=GPnGSA7KH3vqnF1KfzHGzQNvnEBVD3XRfCayEBhQsuRC
NEXT_PUBLIC_STABLE_SYMBOL=tBRL
