# Modo inicial da interface: "demo" (simulacao local) ou "chain" (Solana)
# Desative o modo demo (simulacao local) em deploys publicos: NEXT_PUBLIC_ENABLE_DEMO=false
NEXT_PUBLIC_ENABLE_DEMO=true
NEXT_PUBLIC_DEFAULT_MODE=demo
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_CLUSTER_LABEL=Devnet
NEXT_PUBLIC_EXPLORER_CLUSTER=devnet
NEXT_PUBLIC_PROGRAM_ID=GPnGSA7KH3vqnF1KfzHGzQNvnEBVD3XRfCayEBhQsuRC
NEXT_PUBLIC_STABLE_SYMBOL=tBRL

# --- Tabela FIPE (somente servidor, nunca use o prefixo NEXT_PUBLIC_) ---
# API FIPE v2 (parallelum). Sem token: ~1000 consultas/dia.
# FIPE_API_TOKEN=
# Consulta por placa (WDAPI2 / apiplacas.com.br, pago por consulta).
# Sem token, a aba "Por placa" fica desabilitada e só a busca por modelo funciona.
# PLACA_API_TOKEN=

# Evidencias de sinistro no IPFS (opcional). A chave fica so no servidor.
# Sem ela, o app grava apenas o hash SHA-256 das fotos on-chain.
PINATA_JWT=
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/

# Login com Google/e-mail e carteira Solana embutida (https://dashboard.privy.io). Vazio desativa.
NEXT_PUBLIC_PRIVY_APP_ID=
